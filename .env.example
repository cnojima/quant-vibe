# =============================================================================
# Market Data API Configuration
# Copy this file to .env and fill in your API keys
# =============================================================================

# Schwab API (Market Data & Trading)
# Register at: https://developer.schwab.com/
SCHWAB_API_KEY=your_key_here
SCHWAB_API_SECRET=your_secret_here
SCHWAB_BEARER_TOKEN=your_bearer_token_here
SCHWAB_ACCOUNT_NUMBER=your_account_number
# Schwab OAuth Tokens (managed by token_service)
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/
SCHWAB_TOKENS_DB=./tokens/schwabdev_tokens.db

# Massive.com (formerly Polygon.io) - Options & Stock Market Data
# Get your API key from: https://massive.com/dashboard/keys
MASSIVE_API_KEY=your_key_here

# =============================================================================
# Database Configuration
# =============================================================================
# Set to 'true' to use remote TimescaleDB, 'false' for local
# This affects backtesting data source selection
USE_REMOTE_TIMESCALE=false

# TimescaleDB (for high-frequency options data)
# When using docker-compose, these defaults work out of the box
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=options_data
TIMESCALE_USER=quantvibe
TIMESCALE_PASSWORD=quantvibe_dev
# Remote TimescaleDB (for sync_moirae.py)
REMOTE_TIMESCALE_HOST=your-remote-host.com
REMOTE_TIMESCALE_PORT=5432
REMOTE_TIMESCALE_DB=options_data
REMOTE_TIMESCALE_USER=quantvibe
REMOTE_TIMESCALE_PASSWORD=your-remote-password

# Redis (for real-time data streaming between services)
# When using docker-compose, these defaults work out of the box
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# Application Settings
# =============================================================================

# Data storage directory
DATA_DIR=./data

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Notification Settings (Pushover)
# =============================================================================

# Pushover Push Notifications
# Get your API token and user key from: https://pushover.net
PUSHOVER_API_TOKEN=your_api_token_here
PUSHOVER_USER_KEY=your_user_key_here
PUSHOVER_DEVICE=                          # Optional: specific device name
PUSHOVER_ENABLED=true                     # Enable/disable notifications

# =============================================================================
# Token Service Settings
# =============================================================================

# Token service for centralized OAuth token management
TOKEN_SERVICE_URL=http://localhost:8100
TOKEN_SERVICE_HOST=0.0.0.0
TOKEN_SERVICE_PORT=8100
TOKEN_REFRESH_INTERVAL_MINUTES=14
TOKEN_SERVICE_ENABLE_REDIS=true
TOKEN_SERVICE_LOG_DIR=logs/token_service
TOKEN_SERVICE_LOG_LEVEL=INFO

