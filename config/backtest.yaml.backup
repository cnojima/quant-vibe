engine:
  initial_capital: 100000
  parallel_execution: false
  auto_save_results: true
  output_dir: reports/backtests
date_range:
  preset: this_month
  custom:
    start_date: '2025-12-01'
    end_date: '2025-12-31'
  trading_days_only: true
  market_hours_only: true
strategies:
  enabled:
  - name: throckmorton_credit_ladder
    enabled: true
    params:
      max_trades_daily: 2
      min_dte: 0
      max_dte: 0
      num_spreads: 5
  - name: bullish_vertical_put
    enabled: true
    params:
      max_trades_daily: 3
      spread_width: 10
      observation_period: 15
      pullback_amount: 30
      profit_target_min: 0.5
      profit_target_max: 2
      trailing_stop_pct: 0.3
      min_dte: 0
      max_dte: 2
      num_spreads: 10
      min_volume: 30
      min_bid_ask_spread_pct: 15
      stop_loss_pct: 0.5
  - name: bullish_vertical_call
    enabled: true
    params:
      max_trades_daily: 1
      spread_width: 10
      observation_period: 15
      pullback_amount: 25
      profit_target_min: 0.5
      profit_target_max: 1
      trailing_stop_pct: 0.3
      min_dte: 0
      max_dte: 2
      num_spreads: 10
  - name: bearish_iv_scalp
    enabled: true
    params:
      max_trades_daily: 2
      spread_width: 10
      observation_period: 15
      iv_threshold: 0.15
      iv_spike_pct: 0.1
      profit_target_min: 0.3
      profit_target_max: 0.5
      trailing_stop_pct: 0.03
      stop_loss_pct: 0.75
      min_dte: 0
      max_dte: 0
      num_spreads: 5
      min_volume: 20
      min_bid_ask_spread_pct: 15
      momentum_lookback: 5
      iv_lookback: 30
  - name: coin_toss
    enabled: true
    params:
      target_price: 2
      buy_limit: 1
      sell_target: 2
      price_tolerance: 0.5
      max_trades_daily: 5
      quantity: 10
      min_dte: 0
      max_dte: 0
      profit_target_pct: 1
      stop_loss_pct: 0.3
  - name: coin_toss_limit
    enabled: true
    params:
      target_contract_price: 2
      limit_buy_price: 1
      profit_target_price: 2
      otm_percent_min: 0.1
      otm_percent_max: 0.15
      price_tolerance: 1
      max_trades_daily: 5
      quantity: 10
      min_dte: 0
      max_dte: 0
      stop_loss_pct: 0.5
      order_expiry_minutes: 60
  - name: bollinger_band
    enabled: true
    params:
      target_price: 2
      buy_limit: 1
      sell_target: 2
      otm_percent_min: 0.1
      otm_percent_max: 0.15
      price_tolerance: 1
      max_trades_daily: 5
      quantity: 10
      min_dte: 0
      max_dte: 2
      profit_target_pct: 1
      stop_loss_pct: 0.5
      bb_period: 20
      bb_std: 2
      bb_threshold: 0
  - name: bollinger_band_limit
    enabled: true
    params:
      target_contract_price: 2
      limit_buy_price: 1
      profit_target_price: 2
      otm_percent_min: 0.1
      otm_percent_max: 0.15
      price_tolerance: 1
      max_trades_daily: 5
      quantity: 10
      min_dte: 0
      max_dte: 2
      stop_loss_pct: 0.5
      order_expiry_minutes: 60
      bb_period: 20
      bb_std: 2
      bb_threshold: 0
  - name: naive_bullish_put
    enabled: true
    params:
      min_dte: 0
      max_dte: 0
      max_trades_daily: 10
      spread_width: 20
      profit_target: 0.5
      num_spreads: 10
      trailing_stop_pct: 0
      stop_loss_pct: 0.3
  - name: hail_mary
    enabled: true
    params:
      strike_otm_min_pct: 0.05
      strike_otm_max_pct: 0.1
      entry_time_before_close: 15
      num_contracts: 10
      trailing_stop_pct: 0.05
      min_volume: 50
      max_bid_ask_spread_pct: 15
      max_trades_daily: 1
data_source:
  underlying_ticker: SPX
  db_profile: auto
  min_dte: 0
  max_dte: 2
  verbose: true
  # Data aggregation timeframe: "1min" (default), "5min", "15min", "1hour", "daily"
  # For backtests >30 days, use "5min" to reduce memory by ~95% and speed up loading
  # Example: With 30 days of data:
  #   - "1min": ~1.2M rows, 237 MB (may timeout or run out of memory)
  #   - "5min": ~240K rows, 47 MB (recommended for long backtests)
  timeframe: 1min
reporting:
  print_trade_details: true
  print_educational_metrics: true
  print_performance_summary: true
  save_equity_chart: false
  generate_html_report: false
output:
  timestamp_format: '%Y%m%d_%H%M%S'
  save_trades: true
  save_equity_curve: true
  save_summary: true
  save_log: true
logging:
  log_level: INFO
  tee_output: true
  log_dir: logs/backtests
batch:
  enabled: false
