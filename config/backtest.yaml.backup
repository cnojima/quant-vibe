engine:
  initial_capital: 100000
  parallel_execution: false
  auto_save_results: true
  output_dir: reports/backtests
date_range:
  preset: this_month
  custom:
    start_date: '2025-12-01'
    end_date: '2025-12-31'
  trading_days_only: true
  market_hours_only: true
strategies:
  enabled:
  - name: bullish_vertical_put
    enabled: true
    params:
      max_trades_daily: 3
      spread_width: 10
      observation_period: 15
      pullback_amount: 30
      profit_target_min: 0.5
      profit_target_max: 1
      trailing_stop_pct: 0.05
      min_dte: 0
      max_dte: 2
      num_spreads: 10
      min_volume: 50
      min_bid_ask_spread_pct: 10
  - name: bullish_vertical_call
    enabled: true
    params:
      max_trades_daily: 1
      spread_width: 20
      observation_period: 15
      pullback_amount: 30
      profit_target_min: 0.5
      profit_target_max: 1
      trailing_stop_pct: 0.05
      min_dte: 0
      max_dte: 2
      num_spreads: 10
data_source:
  underlying_ticker: SPX
  db_profile: auto
  min_dte: 0
  max_dte: 2
  verbose: true
reporting:
  print_trade_details: true
  print_educational_metrics: true
  print_performance_summary: true
  save_equity_chart: false
  generate_html_report: false
output:
  timestamp_format: '%Y%m%d_%H%M%S'
  save_trades: true
  save_equity_curve: true
  save_summary: true
  save_log: true
logging:
  log_level: INFO
  tee_output: true
  log_dir: logs/backtests
batch:
  enabled: false
