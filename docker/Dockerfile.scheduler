FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements-related files first for better layer caching
COPY pyproject.toml README.md ./

# Copy src directory for dependency installation
COPY src ./src

# Install Python dependencies in editable mode
# Includes scheduler dependencies (schedule, pytz are in pyproject.toml)
RUN pip install --no-cache-dir -e ".[all]"

# Copy the application code
COPY . .

# Set Python path
ENV PYTHONPATH=/app/src

# Run the scheduler
CMD ["python", "scripts/run_scheduler.py"]
